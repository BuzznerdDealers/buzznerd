{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Dealer Config",
  "description": "Single source of truth for a dealer's identity, branding, contact info, and SEO defaults.",
  "type": "object",
  "required": ["name", "slug", "domain", "url", "brand", "contact", "seo"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "description": "Full legal/display name of the dealer" },
    "shortName": { "type": "string", "description": "Short brand name used in the nav/logo" },
    "slug": { "type": "string", "description": "BuzzNerd channel slug, e.g. dealer1" },
    "domain": { "type": "string", "description": "Custom domain without protocol, e.g. abc.com" },
    "url": { "type": "string", "description": "Full canonical site URL with protocol" },
    "vendureChannelId": { "type": "string" },
    "remixOrigin": { "type": "string", "description": "Remix origin the Worker proxies /inventory/* to" },
    "businessType": {
      "type": "string",
      "description": "schema.org business type for structured data",
      "enum": ["AutoDealer", "Store", "LocalBusiness", "Organization", "AutoPartsStore", "AutoRepair"]
    },
    "tagline": { "type": "string" },
    "brand": {
      "type": "object",
      "required": ["primaryColor", "accentColor"],
      "properties": {
        "primaryColor": { "type": "string" },
        "primaryColorDark": { "type": "string" },
        "accentColor": { "type": "string" },
        "textColor": { "type": "string" },
        "logo": { "type": "string" },
        "logoDark": { "type": "string" },
        "favicon": { "type": "string" },
        "fontHeading": { "type": "string" },
        "fontBody": { "type": "string" }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zip": { "type": "string" },
        "country": { "type": "string" }
      }
    },
    "social": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "seo": {
      "type": "object",
      "properties": {
        "defaultTitle": { "type": "string" },
        "titleTemplate": { "type": "string", "description": "Use %s as the page title placeholder" },
        "defaultDescription": { "type": "string" },
        "ogImage": { "type": "string" },
        "twitterHandle": { "type": "string" },
        "locale": { "type": "string" },
        "themeColor": { "type": "string" }
      }
    }
  }
}
