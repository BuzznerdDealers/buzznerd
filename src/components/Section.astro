---
interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  container?: "default" | "narrow" | "wide" | "full";
  eyebrow?: string;
  title?: string;
  description?: string;
  align?: "left" | "center";
  class?: string;
}

const {
  id,
  background = "default",
  container = "default",
  eyebrow,
  title,
  description,
  align = "center",
  class: className,
} = Astro.props;

const hasHeader = Boolean(eyebrow || title || description);
---

<section
  id={id}
  class:list={["section", `bg-${background}`, className]}
  data-align={align}
>
  <div class:list={["container", `container-${container}`]}>
    {
      hasHeader && (
        <header class:list={["section-header", align === "left" && "is-left"]}>
          {eyebrow && <p class="eyebrow">{eyebrow}</p>}
          {title && <h2>{title}</h2>}
          {description && <p class="section-description">{description}</p>}
        </header>
      )
    }
    <slot />
  </div>
</section>
