---
import { dealer } from "../config";
import nav from "../../content/nav.json";

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  const base = href.split("#")[0];
  if (base === "/") return currentPath === "/";
  return currentPath === base || currentPath.startsWith(base + "/");
}
---

<header class="site-header" data-bz-header>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${dealer.name} home`}>
      {
        dealer.brand.logo ? (
          <img src={dealer.brand.logo} alt={dealer.name} class="brand-logo" />
        ) : (
          <span class="brand-text">{dealer.shortName || dealer.name}</span>
        )
      }
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      {
        nav.items.map((item: any) =>
          item.mega?.links?.length ? (
            <div class="nav-item has-mega">
              <a
                href={item.href}
                class:list={["nav-link", isActive(item.href) && "active"]}
                aria-haspopup="true"
              >
                {item.label}
                <span class="caret" aria-hidden="true">▾</span>
              </a>
              <div class="mega" data-cols={item.mega.columns ?? 2}>
                <div class="mega-grid" data-cols={item.mega.columns ?? 2}>
                  {item.mega.links.map((l: any) => (
                    <a class="mega-link" href={l.href}>
                      {l.emoji && <span class="mega-emoji" aria-hidden="true">{l.emoji}</span>}
                      <span class="mega-copy">
                        <strong>{l.label}</strong>
                        {l.desc && <span class="mega-desc">{l.desc}</span>}
                      </span>
                    </a>
                  ))}
                </div>
                {item.mega.footer && (
                  <a class="mega-footer" href={item.mega.footer.href}>
                    {item.mega.footer.label}
                  </a>
                )}
              </div>
            </div>
          ) : (
            <a
              href={item.href}
              class:list={["nav-link", isActive(item.href) && "active"]}
            >
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <div class="header-actions">
      {nav.textLink && (
        <a class="nav-textlink" href={nav.textLink.href}>{nav.textLink.label}</a>
      )}
      {nav.cta && (
        <a class="btn btn-primary header-cta" href={nav.cta.href}>
          <span class="bolt" aria-hidden="true">⚡</span>{nav.cta.label}
        </a>
      )}
      <button
        class="menu-toggle"
        type="button"
        aria-label="Toggle menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" aria-label="Mobile" data-mobile-nav hidden>
    {
      nav.items.map((item: any) =>
        item.mega?.links?.length ? (
          <details class="mobile-group">
            <summary>{item.label}</summary>
            <div class="mobile-sub">
              {item.mega.links.map((l: any) => (
                <a href={l.href}>
                  {l.emoji && <span aria-hidden="true">{l.emoji} </span>}
                  {l.label}
                </a>
              ))}
              {item.mega.footer && <a href={item.mega.footer.href}>{item.mega.footer.label}</a>}
            </div>
          </details>
        ) : (
          <a href={item.href} class:list={[isActive(item.href) && "active"]}>
            {item.label}
          </a>
        ),
      )
    }
    {nav.textLink && <a href={nav.textLink.href}>{nav.textLink.label}</a>}
    {nav.cta && <a class="btn btn-primary" href={nav.cta.href}>{nav.cta.label}</a>}
  </nav>
</header>
