---
import Section from "../Section.astro";
import Buttons, { type Cta } from "../Buttons.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  title: string;
  body?: string;
  ctas?: Cta[];
}

const { id, background = "primary", title, body, ctas = [] } = Astro.props;
---

<Section id={id} background={background}>
  <div class="cta-block">
    <h2>{title}</h2>
    {body && <p>{body}</p>}
    <Buttons ctas={ctas} class="cta-buttons" />
  </div>
</Section>
