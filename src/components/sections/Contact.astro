---
import Section from "../Section.astro";
import ContactForm from "../ContactForm.tsx";
import Icon from "../Icon.astro";
import { dealer } from "../../config";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  showForm?: boolean;
  showDetails?: boolean;
}

const {
  id,
  background = "default",
  eyebrow,
  title,
  showForm = true,
  showDetails = true,
} = Astro.props;

const c = dealer.contact ?? {};
const address = [c.address, [c.city, c.state].filter(Boolean).join(", "), c.zip]
  .filter(Boolean)
  .join(", ");
---

<Section id={id} background={background} eyebrow={eyebrow} title={title}>
  <div class="contact-grid">
    {
      showDetails && (
        <div class="contact-details">
          {c.phone && (
            <p class="contact-line">
              <Icon name="phone" />
              <a href={`tel:${c.phone.replace(/[^+\d]/g, "")}`}>{c.phone}</a>
            </p>
          )}
          {c.email && (
            <p class="contact-line">
              <Icon name="check" />
              <a href={`mailto:${c.email}`}>{c.email}</a>
            </p>
          )}
          {address && <p class="contact-address">{address}</p>}
        </div>
      )
    }
    {showForm && <ContactForm client:visible />}
  </div>
</Section>
