---
import Section from "../Section.astro";
import Icon from "../Icon.astro";

interface LocationItem {
  name: string;
  address?: string;
  city?: string;
  state?: string;
  zip?: string;
  phone?: string;
  hours?: string;
  mapUrl?: string;
}

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  items: LocationItem[];
}

const { id, background = "default", eyebrow, title, items = [] } = Astro.props;

function line(loc: LocationItem) {
  return [loc.address, [loc.city, loc.state].filter(Boolean).join(", "), loc.zip]
    .filter(Boolean)
    .join(" · ");
}
---

<Section id={id} background={background} eyebrow={eyebrow} title={title}>
  <div class="grid" data-cols={items.length >= 3 ? 3 : items.length || 1}>
    {
      items.map((loc) => (
        <div class="card location">
          <h3>{loc.name}</h3>
          {line(loc) && <p class="location-address">{line(loc)}</p>}
          {loc.phone && (
            <p class="location-line">
              <Icon name="phone" /> <a href={`tel:${loc.phone.replace(/[^+\d]/g, "")}`}>{loc.phone}</a>
            </p>
          )}
          {loc.hours && <p class="location-hours">{loc.hours}</p>}
          {loc.mapUrl && (
            <a class="location-map" href={loc.mapUrl} target="_blank" rel="noopener">
              Get directions →
            </a>
          )}
        </div>
      ))
    }
  </div>
</Section>
