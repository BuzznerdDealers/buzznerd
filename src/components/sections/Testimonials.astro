---
import Section from "../Section.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  items: { quote: string; author: string; role?: string }[];
}

const { id, background = "muted", eyebrow, title, items = [] } = Astro.props;
---

<Section id={id} background={background} eyebrow={eyebrow} title={title}>
  <div class="grid" data-cols={items.length >= 2 ? 2 : 1}>
    {
      items.map((t) => (
        <figure class="card testimonial">
          <blockquote>{t.quote}</blockquote>
          <figcaption>
            <strong>{t.author}</strong>
            {t.role && <span>{t.role}</span>}
          </figcaption>
        </figure>
      ))
    }
  </div>
</Section>
