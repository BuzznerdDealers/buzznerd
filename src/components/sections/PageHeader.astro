---
import Buttons, { type Cta } from "../Buttons.astro";

interface Props {
  eyebrow?: string;
  title: string;
  subheadline?: string;
  ctas?: Cta[];
}

const { eyebrow, title, subheadline, ctas = [] } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {subheadline && <p class="page-header-sub">{subheadline}</p>}
    <Buttons ctas={ctas} />
  </div>
</section>
