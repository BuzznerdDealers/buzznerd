---
import Section from "../Section.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  title?: string;
  items: { value: string; label: string }[];
}

const { id, background = "dark", title, items = [] } = Astro.props;
---

<Section id={id} background={background} title={title}>
  <div class="stats" data-cols={items.length}>
    {
      items.map((s) => (
        <div class="stat">
          <strong>{s.value}</strong>
          <span>{s.label}</span>
        </div>
      ))
    }
  </div>
</Section>
