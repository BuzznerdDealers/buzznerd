---
import Section from "../Section.astro";
import Buttons, { type Cta } from "../Buttons.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  body?: string;
  image?: string;
  imageSide?: "left" | "right";
  ctas?: Cta[];
}

const {
  id,
  background = "default",
  eyebrow,
  title,
  body,
  image,
  imageSide = "right",
  ctas = [],
} = Astro.props;

const paragraphs = body ? body.split(/\n\n+/).filter(Boolean) : [];
---

<Section id={id} background={background}>
  <div class:list={["split", imageSide === "left" && "split-reverse"]}>
    <div class="split-copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      {title && <h2>{title}</h2>}
      {paragraphs.map((p) => <p class="split-text">{p}</p>)}
      <Buttons ctas={ctas} />
    </div>
    <div class="split-media">
      {image ? <img src={image} alt="" loading="lazy" /> : <div class="media-placeholder" />}
    </div>
  </div>
</Section>
