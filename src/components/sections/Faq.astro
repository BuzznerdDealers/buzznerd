---
import Section from "../Section.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  description?: string;
  items: { question: string; answer: string }[];
}

const { id, background = "default", eyebrow, title, description, items = [] } = Astro.props;
---

<Section id={id} background={background} container="narrow" eyebrow={eyebrow} title={title} description={description}>
  <div class="faq">
    {
      items.map((item) => (
        <details class="faq-item">
          <summary>{item.question}</summary>
          <div class="faq-answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</Section>
