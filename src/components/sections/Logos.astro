---
import Section from "../Section.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  description?: string;
  /** When true, render a continuously scrolling grayscale marquee. */
  marquee?: boolean;
  items: { name: string; logo?: string; href?: string }[];
}

const {
  id,
  background = "default",
  eyebrow,
  title,
  description,
  marquee = false,
  items = [],
} = Astro.props;

// Duplicate the list so the marquee can loop seamlessly.
const loop = marquee ? [...items, ...items] : items;
---

<Section
  id={id}
  background={background}
  eyebrow={eyebrow}
  title={title}
  description={description}
>
  {
    marquee ? (
      <div class="logo-marquee" aria-label="Trusted integrations">
        <div class="logo-track">
          {loop.map((item) => (
            <span class="logo" aria-hidden={item.name ? "false" : "true"}>
              {item.logo ? (
                <img src={item.logo} alt={item.name} loading="lazy" />
              ) : (
                <span class="logo-text">{item.name}</span>
              )}
            </span>
          ))}
        </div>
      </div>
    ) : (
      <div class="logos">
        {items.map((item) => {
          const inner = item.logo ? (
            <img src={item.logo} alt={item.name} loading="lazy" />
          ) : (
            <span class="logo-text">{item.name}</span>
          );
          return item.href ? (
            <a href={item.href} class="logo" aria-label={item.name}>
              {inner}
            </a>
          ) : (
            <div class="logo">{inner}</div>
          );
        })}
      </div>
    )
  }
</Section>
