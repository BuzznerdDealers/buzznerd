---
import Section from "../Section.astro";

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  columns?: 2 | 3 | 4;
  items: { image: string; alt?: string; caption?: string }[];
}

const { id, background = "default", eyebrow, title, columns = 3, items = [] } = Astro.props;
---

<Section id={id} background={background} eyebrow={eyebrow} title={title}>
  <div class="grid" data-cols={columns}>
    {
      items.map((item) => (
        <figure class="gallery-item">
          <img src={item.image} alt={item.alt || ""} loading="lazy" />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))
    }
  </div>
</Section>
