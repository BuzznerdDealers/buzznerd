---
import Section from "../Section.astro";
import Icon from "../Icon.astro";

interface FeatureItem {
  title: string;
  body?: string;
  icon?: string;
  emoji?: string;
  href?: string;
  linkLabel?: string;
}

interface Props {
  id?: string;
  background?: "default" | "muted" | "dark" | "primary";
  eyebrow?: string;
  title?: string;
  description?: string;
  align?: "left" | "center";
  columns?: 2 | 3 | 4;
  items: FeatureItem[];
}

const {
  id,
  background = "default",
  eyebrow,
  title,
  description,
  align = "center",
  columns = 3,
  items = [],
} = Astro.props;
---

<Section
  id={id}
  background={background}
  eyebrow={eyebrow}
  title={title}
  description={description}
  align={align}
>
  <div class="grid" data-cols={columns}>
    {
      items.map((item) => {
        const Tag = item.href ? "a" : "div";
        return (
          <Tag class="card feature-card" href={item.href}>
            {(item.emoji || item.icon) && (
              <span class:list={["feature-icon", item.emoji && "is-emoji"]}>
                {item.emoji ? item.emoji : <Icon name={item.icon} />}
              </span>
            )}
            <h3>{item.title}</h3>
            {item.body && <p>{item.body}</p>}
            {item.href && (
              <span class="feature-link">{item.linkLabel || "Learn more"} →</span>
            )}
          </Tag>
        );
      })
    }
  </div>
</Section>
