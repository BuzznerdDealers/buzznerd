  check: "M20 6 9 17l-5-5",
  dot: "M12 12h.01",
};

const d = paths[name] ?? paths.dot;
---

<svg
  class={className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
