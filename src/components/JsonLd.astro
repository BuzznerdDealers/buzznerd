---
interface Props {
  /** One schema.org node or an array of them. */
  schema: Record<string, unknown> | Record<string, unknown>[];
}

const { schema } = Astro.props;
const nodes = Array.isArray(schema) ? schema : [schema];
// Strip undefined values so the emitted JSON-LD stays clean.
const json = JSON.stringify(nodes.length === 1 ? nodes[0] : nodes, (_k, v) =>
  v === undefined ? undefined : v,
);
---

<script type="application/ld+json" set:html={json} is:inline />
