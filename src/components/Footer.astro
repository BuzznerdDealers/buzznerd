---
import { dealer, socialLinks } from "../config";
import footer from "../../content/footer.json";

const year = new Date().getFullYear();
const socials = socialLinks();
const c = dealer.contact ?? {};
const legal = `© ${year} ${dealer.name}. ${footer.legal || "All rights reserved."}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand">
        {
          dealer.brand.logoDark || dealer.brand.logo ? (
            <img src={dealer.brand.logoDark || dealer.brand.logo} alt={dealer.name} class="brand-logo" />
          ) : (
            <span class="brand-text">{dealer.shortName || dealer.name}</span>
          )
        }
      </a>
      {footer.note && <p class="footer-note">{footer.note}</p>}
      {
        socials.length > 0 && (
          <div class="footer-social">
            {socials.map((s) => (
              <a href={s.url} aria-label={s.network} target="_blank" rel="noopener">
                {s.network[0].toUpperCase()}
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      footer.columns?.map((col: any) => (
        <div class="footer-col">
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((link: any) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    <div class="footer-col">
      <h3>Contact</h3>
      <ul>
        {c.phone && <li><a href={`tel:${c.phone.replace(/[^+\d]/g, "")}`}>{c.phone}</a></li>}
        {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
        {c.address && <li>{[c.address, c.city, c.state, c.zip].filter(Boolean).join(", ")}</li>}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <p>{legal}</p>
  </div>
</footer>
