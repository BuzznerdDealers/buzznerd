---
import { dealer, socialLinks } from "../config";
import footer from "../../content/footer.json";
import { version } from "../../content/version.json";

const year = new Date().getFullYear();
const socials = socialLinks();
const c = dealer.contact ?? {};
const cta = (footer as any).cta;
const legalLinks = (footer as any).legalLinks ?? [];
const location = [c.city, c.state].filter(Boolean).join(", ");
const legal = `© ${year} ${dealer.name}. ${footer.legal || "All rights reserved."}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand">
        {
          dealer.brand.logoDark || dealer.brand.logo ? (
            <img src={dealer.brand.logoDark || dealer.brand.logo} alt={dealer.name} class="brand-logo" />
          ) : (
            <span class="brand-text">{dealer.shortName || dealer.name}</span>
          )
        }
      </a>
      {footer.note && <p class="footer-note">{footer.note}</p>}
      {location && <p class="footer-location">📍 {location}</p>}
      {
        socials.length > 0 && (
          <div class="footer-social">
            {socials.map((s) => (
              <a href={s.url} aria-label={s.network} target="_blank" rel="noopener">
                {s.network[0].toUpperCase()}
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      footer.columns?.map((col: any) => (
        <div class="footer-col">
          <h3>{col.title}</h3>
          <ul>
            {col.links.map((link: any) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }

    {
      cta && (
        <div class="footer-col footer-cta">
          <h3>{cta.title}</h3>
          {cta.body && <p class="footer-cta-body">{cta.body}</p>}
          {cta.primary && (
            <a class="btn btn-primary" href={cta.primary.href}>
              <span class="bolt" aria-hidden="true">⚡</span>{cta.primary.label}
            </a>
          )}
          {cta.secondary && (
            <a class="footer-cta-link" href={cta.secondary.href}>{cta.secondary.label} →</a>
          )}
          {c.email && (
            <a class="footer-cta-link" href={`mailto:${c.email}`}>{c.email}</a>
          )}
        </div>
      )
    }
  </div>

  <div class="container footer-bottom">
    <p>{legal}</p>
    <div class="footer-legal-links">
      {legalLinks.map((l: any) => <a href={l.href}>{l.label}</a>)}
      {version && <span class="footer-version">v{version}</span>}
    </div>
  </div>
</footer>
