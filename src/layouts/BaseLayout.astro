---
import Header from "../components/Header";
import Footer from "../components/Footer";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BuzzNerd | Dealership Platform",
  description = "BuzzNerd helps truck, trailer, and heavy equipment dealers sell online with branded storefronts, inventory tools, and marketplace reach.",
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Header currentPath={currentPath} client:load />

    <main>
      <slot />
    </main>

    <Footer />
  </body>
</html>
