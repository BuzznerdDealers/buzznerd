---
import "../styles/global.css";
import Head from "../components/Head.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Seo from "../components/Seo.astro";
import JsonLd from "../components/JsonLd.astro";
import { dealer } from "../config";
import { organizationSchema, websiteSchema } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Extra JSON-LD nodes to emit for this page (WebPage, FAQPage, etc.). */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  ogImage,
  ogType,
  noindex,
  jsonLd = [],
} = Astro.props;

const brand = dealer.brand;
const fonts = Array.from(
  new Set([brand.fontHeading, brand.fontBody].filter(Boolean)),
);
const fontQuery = fonts
  .map((f) => `family=${f!.replace(/ /g, "+")}:wght@400;500;600;700;800`)
  .join("&");

// Global structured data emitted on every page.
const globalSchema = [organizationSchema(), websiteSchema()];

// Brand tokens are build-time constants from dealer.config.json, so we inline
// them directly into :root. Every component reads these via var(--primary) etc.
const brandTokens = `:root{
  --primary:${brand.primaryColor};
  --primary-dark:${brand.primaryColorDark || brand.primaryColor};
  --accent:${brand.accentColor};
  --text:${brand.textColor || "#0f172a"};
  --font-heading:'${brand.fontHeading}',sans-serif;
  --font-body:'${brand.fontBody}',sans-serif;
}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content={dealer.seo.themeColor || brand.primaryColor} />
    <link rel="icon" href={brand.favicon || "/favicon.svg"} />

    {
      fonts.length > 0 && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link href={`https://fonts.googleapis.com/css2?${fontQuery}&display=swap`} rel="stylesheet" />
        </>
      )
    }

    <Seo
      title={title}
      description={description}
      path={path}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />

    <JsonLd schema={globalSchema} />
    {jsonLd.length > 0 && <JsonLd schema={jsonLd} />}

    <style set:html={brandTokens} is:inline></style>

    {/* Dealer <head> injections (analytics, pixels). Same source Remix pulls via /partials/head.html. */}
    <Head />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    {/* Chrome JS (mobile nav). Same file Remix loads via /partials/scripts.js. */}
    <script is:inline src="/partials/scripts.js" defer></script>
  </body>
</html>
