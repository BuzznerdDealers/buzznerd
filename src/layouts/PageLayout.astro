---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import SectionRenderer from "../components/SectionRenderer.astro";
import { webPageSchema, faqSchema, breadcrumbSchema } from "../lib/schema";

interface Props {
  entry: CollectionEntry<"pages">;
  path: string;
}

const { entry, path } = Astro.props;
const { data } = entry;
const seo = data.seo ?? {};

// Build page-level structured data. FAQ schema is derived automatically from
// any `faq` section so rich results "just work" when content is added.
const jsonLd: Record<string, unknown>[] = [
  webPageSchema({ path, title: seo.title || data.title, description: seo.description }),
];

const faqSection = data.sections.find((s) => s.type === "faq") as
  | { items?: { question: string; answer: string }[] }
  | undefined;
if (faqSection?.items?.length) jsonLd.push(faqSchema(faqSection.items));

if (path !== "/") {
  jsonLd.push(
    breadcrumbSchema([
      { name: "Home", path: "/" },
      { name: data.title, path },
    ]),
  );
}
---

<BaseLayout
  title={seo.title || data.title}
  description={seo.description}
  path={path}
  ogImage={seo.ogImage}
  noindex={seo.noindex}
  jsonLd={jsonLd}
>
  <SectionRenderer sections={data.sections} />
</BaseLayout>
