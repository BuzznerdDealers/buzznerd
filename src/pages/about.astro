---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<BaseLayout
  title="About | BuzzNerd"
  description="Learn how BuzzNerd helps truck, trailer, and heavy equipment dealerships sell online."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">About BuzzNerd</p>
      <h1>The platform dealers wish they had years ago.</h1>
      <p>
        We built BuzzNerd because selling trucks, trailers, and heavy equipment
        online shouldn’t require a full engineering team or a patchwork of
        disconnected tools.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <SectionHeader
        align="left"
        eyebrow="Our Mission"
        title="Modern commerce for traditional dealerships"
        description="BuzzNerd connects inventory, storefronts, payments, and fulfillment in one platform designed for the heavy equipment industry."
      />

      <div class="prose">
        <p>
          Dealerships run on tight margins and fast turnover. BuzzNerd gives
          them a branded online presence, real-time inventory tools, and access
          to a marketplace of qualified buyers — without sacrificing control of
          their brand or customer relationships.
        </p>
        <p>
          Whether you sell trucks, trailers, RVs, boats, parts, or construction
          equipment, BuzzNerd adapts to your inventory types and grows with your
          business.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
