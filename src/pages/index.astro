---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeader from "../components/SectionHeader.astro";
---

<BaseLayout
  title="BuzzNerd | Dealership Platform for Heavy Equipment"
  description="Sell trucks, trailers, parts, and equipment online with branded storefronts, inventory management, and marketplace reach."
>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow">Dealership Platform</p>
        <h1>Sell heavy equipment online without rebuilding your business.</h1>
        <p>
          BuzzNerd gives truck, trailer, and equipment dealers branded
          storefronts, live inventory, mobile tools, and marketplace reach —
          so you can move metal faster.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="/contact">Book a Demo</a>
          <a class="button secondary" href="/services">Explore Services</a>
        </div>
      </div>

      <div class="hero-card" aria-label="Platform highlights">
        <div class="metric-card">
          <span>Branded</span>
          <strong>Dealer Storefronts</strong>
        </div>
        <div class="metric-card">
          <span>Live</span>
          <strong>Inventory Sync</strong>
        </div>
        <div class="metric-card">
          <span>Built for</span>
          <strong>Heavy Equipment</strong>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHeader
        eyebrow="Why BuzzNerd"
        title="Everything dealers need to sell online"
        description="From lot to listing to delivery — one platform built for the way dealerships actually work."
      />

      <div class="card-grid">
        <article class="feature-card">
          <h3>Branded Storefronts</h3>
          <p>
            Launch a professional site on your domain or a BuzzNerd subdomain,
            with your logo, colors, and live inventory.
          </p>
        </article>
        <article class="feature-card">
          <h3>Inventory Management</h3>
          <p>
            Manage trucks, trailers, parts, and equipment across locations with
            tools built for dealer workflows.
          </p>
        </article>
        <article class="feature-card">
          <h3>Marketplace Reach</h3>
          <p>
            List inventory on the BuzzNerd network and reach buyers searching
            for heavy equipment nationwide.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section muted-section">
    <div class="container split-section">
      <div>
        <p class="eyebrow">Built for dealers</p>
        <h2>Your lot. Your brand. Our platform.</h2>
      </div>
      <p>
        BuzzNerd handles the digital infrastructure — storefronts, payments,
        shipping labels, and marketplace syndication — so your team can focus on
        sourcing inventory, closing deals, and serving customers.
      </p>
    </div>
  </section>
</BaseLayout>
