---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { blogPostingSchema, breadcrumbSchema } from "../../lib/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts
    .filter((p) => !p.data.draft)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const path = `/blog/${entry.id}`;

const dateFmt = new Intl.DateTimeFormat("en-US", { dateStyle: "long" });

const jsonLd = [
  blogPostingSchema({
    path,
    title: data.title,
    description: data.excerpt,
    date: data.date,
    author: data.author,
    image: data.coverImage?.src,
  }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Blog", path: "/blog" },
    { name: data.title, path },
  ]),
];
---

<BaseLayout
  title={data.seo?.title || data.title}
  description={data.seo?.description || data.excerpt}
  path={path}
  ogImage={data.seo?.ogImage || data.coverImage?.src}
  ogType="article"
  noindex={data.seo?.noindex}
  jsonLd={jsonLd}
>
  <article class="blog-post">
    <header class="page-header">
      <div class="container container-narrow">
        <p class="eyebrow">
          {dateFmt.format(data.date)} · {data.author}
        </p>
        <h1>{data.title}</h1>
      </div>
    </header>

    {
      data.coverImage && (
        <div class="container container-narrow">
          <img class="blog-cover" src={data.coverImage.src} alt="" />
        </div>
      )
    }

    <div class="container container-narrow prose blog-content">
      <Content />
    </div>
  </article>
</BaseLayout>
