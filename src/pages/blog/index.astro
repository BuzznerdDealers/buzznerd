---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogList from "../../components/BlogList.astro";
import { getSortedPosts, POSTS_PER_PAGE } from "../../lib/blog";

// Page 1 of the blog. Later pages live at /blog/page/2, /blog/page/3, …
const allPosts = await getSortedPosts();
const totalPages = Math.max(1, Math.ceil(allPosts.length / POSTS_PER_PAGE));
const posts = allPosts.slice(0, POSTS_PER_PAGE);
---

<BaseLayout title="Blog" description="News, tips, and updates." path="/blog">
  <BlogList posts={posts} currentPage={1} totalPages={totalPages} />
</BaseLayout>
