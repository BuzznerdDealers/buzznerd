      }
    }
  ],
  "js": "/* Keep the footer copyright year current. */\n(function () {\n  var node = document.querySelector('[data-bz-node=\"footer-copy\"] p');\n  if (node) node.innerHTML = node.innerHTML.replace(/\\u00a9\\s*\\d{4}/, '\\u00a9 ' + new Date().getFullYear());\n})();\n"
}
