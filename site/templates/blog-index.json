{
  "version": 2,
  "id": "blog-index",
  "name": "Blog index",
  "conditions": [
    {
      "type": "blog",
      "ref": null
    }
  ],
  "nodes": [
    {
      "id": "header",
      "type": "sharedSection",
      "props": {
        "sectionId": "site-header",
        "values": {}
      }
