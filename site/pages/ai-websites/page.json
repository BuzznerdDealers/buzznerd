      "props": {
        "sectionId": "faq-band",
        "values": {
          "eyebrow": "Questions dealers ask",
          "heading": "Frequently asked questions.",
          "faqs": [
            {
              "q": "Can Buzznerd build one website for a dealership that sells multiple brands?",
              "a": "Yes. We build a single site with an interactive location finder, so buyers filter by OEM brand and the services they need and get routed to the right rooftop. We also custom-build OEM spec'd brand pages so each manufacturer's inventory and identity gets its own dedicated home."
            },
            {
              "q": "Does a Buzznerd website connect to my existing DMS and tools?",
              "a": "Yes. Buzznerd integrates with the platforms dealers already rely on — including Karmak and CDK — plus custom DMS and ERP integrations, so your inventory, leads, and sold units flow through one connected platform."
            },
            {
              "q": "What does it mean that Buzznerd sites are optimized for AI?",
              "a": "Every site is built for SEO, AEO (Answer Engine Optimization), GEO (local/generative visibility), and AIO (AI Optimization) — clean structure, inventory schema, and content shaped to be the answer when buyers ask ChatGPT, Gemini, or Google AI for a unit or service, so your dealership gets named, not skipped."
            },
            {
              "q": "How does a Buzznerd website help me generate more leads?",
              "a": "Every page is a lead path — clear calls to action, easy forms, strong inventory pages, and department-specific lead capture. An AI assistant answers buyer questions around the clock and hands warm leads to your team."
            },
            {
              "q": "What types of dealerships does Buzznerd work with?",
              "a": "Buzznerd builds AI-enabled websites for commercial truck, trailer, equipment, and parts dealerships, including multi-location and multi-brand operations. We power 700+ rooftops and hold a 4.8 rating on Google."
            },
            {
              "q": "Can I see it on my own inventory before committing?",
              "a": "Yes. Book a 20-minute demo, no slides — we'll walk your actual site and show you where leads are leaking today and what a Buzznerd build would change."
            }
          ]
        }
      }
