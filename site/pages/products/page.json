            {
              "icon": "🌐",
              "title": "Build a smarter dealership website.",
              "kicker": "AI Websites",
              "body": "Lightning-fast, conversion-tuned sites that pull inventory in real time and turn browsers into booked appointments — built for speed, SEO and AI answer engines.\n\nReal-time inventory sync from your feed or DMS\n\nMobile-first, accessibility & Core-Web-Vitals ready\n\nLead forms, chat and financing built in",
              "linkLabel": "Explore AI Websites →",
              "url": "/ai-websites"
            },
            {
              "icon": "🛒",
              "title": "Sell parts & products 24/7 nationwide.",
              "kicker": "AI E-Commerce",
              "body": "A storefront built for dealership complexity — checkout that closes while the counter is dark, with account pricing, shipping rules and secure payments.\n\nParts & accessories storefront with Stripe checkout\n\nAccount-based pricing and customer workflows\n\nWorks with Karmak and CDK + custom DMS/ERP",
              "linkLabel": "Explore AI E-Commerce →",
              "url": "/ai-ecommerce"
            },
            {
              "icon": "⚡",
              "title": "AI that works your leads while you sleep.",
              "kicker": "AI Platform",
              "body": "The AI under everything Buzznerd builds — answering leads after hours, ranking your morning follow-ups, building listings from a photo, and tracing every channel to the sold unit.\n\nAI Assistant + No-Touch CRM morning digest\n\nMagic Flow photo-to-listing in about a minute\n\nChannel-to-sale attribution, not vanity metrics",
              "linkLabel": "Explore the AI Platform →",
              "url": "/ai-platform"
            }
