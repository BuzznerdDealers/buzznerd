    {
      "id": "faq",
      "type": "sharedSection",
      "props": {
        "sectionId": "faq-band",
        "values": {
          "eyebrow": "FAQ",
          "heading": "Questions dealers ask us",
          "faqs": [
            {
              "q": "What does Buzznerd do?",
              "a": "Buzznerd is a technology company that provides AI solutions for truck, trailer and equipment dealerships — high-converting websites, online ecommerce, CRM & DMS integrations, AIO/GEO AI search visibility, AI photo & background enhancement, AI Assistant, and sales attribution analytics."
            },
            {
              "q": "What types of dealerships do you work with?",
              "a": "Every kind — franchise, independent, commercial, fleet, and truck and trailer dealers. Our platform scales from a single rooftop to large dealership groups. Auto, powersports, boat, or another kind of dealer? Why not — contact us."
            },
            {
              "q": "What is AIO / GEO and why does it matter?",
              "a": "AIO (AI Optimization) and GEO (Generative Engine Optimization) make your dealership the answer AI engines recommend. We structure your inventory, reviews, and pages so ChatGPT, Google AI, and Gemini cite your store when buyers ask for the best dealer near them."
            },
            {
              "q": "Will you replace our existing marketing team?",
              "a": "No. If you have a marketing team, we make them rock stars with the tech, content, and AI horsepower to do their best work. Everything we build is designed to make your existing team faster and more effective."
            },
            {
              "q": "Which systems do you integrate with?",
              "a": "The platforms dealers already rely on — including Karmak, CDK, and major DMS & CRM systems, inventory marketplaces like Truck Paper and Machinery Trader, and tools like Google, Facebook, and Stripe."
            },
            {
              "q": "How is Buzznerd rated by dealers?",
              "a": "Buzznerd is rated 4.8 out of 5 on Google, with multiple 5-star reviews from dealership marketing managers and principals praising our responsiveness, innovation, and results."
            }
          ]
        },
        "snapshots": {
          "faq-list": {
            "items": []
          }
        }
      }
