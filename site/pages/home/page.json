            {
              "icon": "🌐",
              "title": "AI Dealership Websites",
              "body": "Lightning-fast, conversion-tuned sites that update inventory in real time and turn browsers into showroom appointments.",
              "linkLabel": "Explore AI Websites →",
              "url": "/ai-websites"
            },
            {
              "icon": "🛒",
              "title": "AI E-Commerce",
              "body": "Sell vehicles, parts, and service online with digital deals, financing, and checkout that closes while you sleep.",
              "linkLabel": "Explore AI E-Commerce →",
              "url": "/ai-ecommerce"
            },
            {
              "icon": "🔌",
              "title": "CRM & DMS Integrations",
              "body": "Plug into the tools you already run. We sync leads, inventory, and deals across your entire stack — no double entry.",
              "linkLabel": "See integrations →",
              "url": "/solutions#integrations"
            },
            {
              "icon": "🔎",
              "title": "AIO / GEO Visibility",
              "body": "Get cited by ChatGPT, Google AI, and Gemini. We optimize your dealership to be the answer buyers' AI recommends.",
              "linkLabel": "Explore AIO / GEO →",
              "url": "/content-restructuring-for-aio"
            },
            {
              "icon": "💬",
              "title": "AI Assistant",
              "body": "24/7 AI Assistant that answers questions and reads each buyer's intent and readiness — handing your team buyers who are ready to talk.",
              "linkLabel": "Meet the AI Assistant →",
              "url": "/ai-platform#assistant"
            },
            {
              "icon": "📊",
              "title": "Attribution Analytics",
              "body": "See exactly which channels drive sold units. Real ROI dashboards, not vanity metrics — built for GMs.",
              "linkLabel": "See attribution →",
