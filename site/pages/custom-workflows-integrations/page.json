    {
      "id": "faq",
      "type": "sharedSection",
      "props": {
        "sectionId": "faq-band",
        "values": {
          "eyebrow": "Questions dealers ask",
          "heading": "Frequently asked questions.",
          "faqs": [
            {
              "q": "Which systems can Buzznerd connect?",
              "a": "Buzznerd connects your website, inventory providers, CRM, DMS, e-commerce, and marketing platforms — including Karmak and CDK, plus custom DMS and ERP integrations for other third-party systems."
            },
            {
              "q": "Can Buzznerd build a workflow specific to how my dealership operates?",
              "a": "Yes. Buzznerd builds custom workflows around your operations — inventory and product syncing, lead routing, customer and account workflows, reporting dashboards, and multi-location processes that respect how your rooftops divide the work."
            },
            {
              "q": "Will connecting my systems reduce double data entry?",
              "a": "Yes. Connected systems mean data flows from your source of record to every channel automatically, so your team spends less time retyping and more time selling, with cleaner, more accurate data."
            },
            {
              "q": "Do I need Buzznerd's other products to use integrations?",
              "a": "Integrations and workflows work best alongside a Buzznerd website, e-commerce, and the AI platform, but we'll discuss connecting your current systems during a demo."
            },
            {
              "q": "How do integrations support AI tools?",
              "a": "A clean, connected data foundation is what AI tools build on. When your inventory, leads, and customer data are connected and accurate, AI-connected workflows and assistants can act on reliable information."
            }
          ]
        },
        "snapshots": {
          "faq-list": {
            "items": []
          }
