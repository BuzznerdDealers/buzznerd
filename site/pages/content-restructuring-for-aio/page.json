        "values": {
          "eyebrow": "Questions dealers ask",
          "heading": "Frequently asked questions.",
          "faqs": [
            {
              "q": "What is content restructuring for AIO?",
              "a": "AIO means AI Optimization. Buzznerd restructures your dealership pages — headings, structure, descriptions, and formatting — so content is easy for buyers to read, easy for search engines to rank, and easy for AI answer engines like ChatGPT, Gemini, and Google AI to understand and cite."
            },
            {
              "q": "Which pages does Buzznerd restructure?",
              "a": "Buzznerd restructures the pages that earn business — sales, service, parts, inventory, location, finance, department, campaign, and landing pages."
            },
            {
              "q": "Do I have to rewrite everything myself?",
              "a": "No. Buzznerd's team audits, rewrites, and restructures your pages for you, so your staff stays focused on selling while your content gets stronger."
            },
            {
              "q": "How is this different from normal SEO?",
              "a": "Traditional SEO focuses on ranking in search. Content restructuring for AIO makes pages perform everywhere at once — readable for buyers, structured for search engines, and clear enough for AI platforms to recommend your dealership."
            },
            {
              "q": "Will restructuring help me show up in AI answers?",
              "a": "Yes. Clean structure, clear headings, and well-organized descriptions make it far more likely that AI answer engines understand your pages and name your dealership when buyers ask. You can also check where you stand with a free AI Presence Score."
            }
          ]
        },
